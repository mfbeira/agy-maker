# ==============================================================================
# ARQUIVO DE AMBIENTE (.env.example) - MODELO DE CONFIGURAÇÕES
# ==============================================================================
# Copie este arquivo para '.env' e preencha com as suas configurações locais.
# NUNCA envie o arquivo '.env' preenchido para o GitHub ou controle de versão.

# ------------------------------------------------------------------------------
# 1. INTELIGÊNCIA ARTIFICIAL (Ollama, Gemini & Outros Provedores)
# ------------------------------------------------------------------------------

# URL padrão para instância local do Ollama (Economia de tokens e processamento local)
OLLAMA_API_URL="http://localhost:11434"
# Modelo local padrão utilizado pelo Ollama
OLLAMA_MODELO="llama3"

# Google Gemini API Key (Para modelos em nuvem Google Antigravity / Gemini)
GOOGLE_API_KEY="AIzaSy_SUA_CHAVE_AQUI"

# ------------------------------------------------------------------------------
# 2. FERRAMENTAS E APIS EXTERNAS
# ------------------------------------------------------------------------------

# Chave de acesso à API do Firecrawl (Para raspagem e extração web estruturada)
FIRECRAWL_API_KEY="fc_SUA_CHAVE_AQUI"

# ------------------------------------------------------------------------------
# 3. TRANSFERÊNCIA E ARMAZENAMENTO DE DADOS
# ------------------------------------------------------------------------------

# Servidor FTP / SFTP
FTP_HOST="ftp.seusite.com.br"
FTP_USUARIO="seu_usuario"
FTP_SENHA="sua_senha_secreta"
FTP_PORTA="21"

# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# ------------------------------------------------------------------------------

# Ambiente de execução (development | test | production)
NODE_ENV="development"

# Porta onde o servidor da aplicação roda localmente
PORT="3000"
