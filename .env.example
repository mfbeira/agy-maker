# ==============================================================================
# .env.example — Modelo de Configurações de Ambiente
# ==============================================================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo para `.env` (no mesmo diretório)
# 2. Preencha com suas configurações reais
# 3. NUNCA committe `.env` no Git — adicione ao .gitignore
# 4. Mantenha este arquivo (.env.example) sempre sincronizado com as variáveis reais
#
# Para variáveis sensíveis (chaves, senhas), use um secrets manager:
# - GitHub Secrets (para CI/CD)
# - 1Password, Vault, etc. (para desenvolvimento local)
#

# ==============================================================================
# 1. AMBIENTE E DEBUG
# ==============================================================================

# Ambiente de execução (development | staging | production)
NODE_ENV=development

# Nível de logging (debug | info | warn | error)
LOG_LEVEL=debug

# Porta do servidor local
PORT=3000

# ==============================================================================
# 2. INTELIGÊNCIA ARTIFICIAL (Local & Cloud)
# ==============================================================================

# Ollama — Modelos LLM locais (para economia de tokens)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODELO=llama2          # Opções: llama2, mistral, neural-chat, etc.

# Google Gemini API (para uso em nuvem)
GOOGLE_API_KEY=AIzaSy_SUA_CHAVE_GOOGLE_AQUI

# OpenRouter (gateway de múltiplos provedores)
OPENROUTER_API_KEY=sk_sua_chave_openrouter_aqui

# ==============================================================================
# 3. BANCO DE DADOS
# ==============================================================================

# PostgreSQL (principal)
DATABASE_URL=postgresql://user:password@localhost:5432/seu_banco
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_MS=5000

# Redis (cache, sessions)
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# ==============================================================================
# 4. AUTENTICAÇÃO & SEGURANÇA
# ==============================================================================

# JWT — Tokens de sessão
JWT_SECRET=sua_chave_secreta_de_32_caracteres_aqui_mesmo
JWT_EXPIRY_HOURS=24

# OAuth 2.0 — Google
GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=sua_client_secret_google

# OAuth 2.0 — GitHub
GITHUB_CLIENT_ID=seu_client_id_github
GITHUB_CLIENT_SECRET=sua_client_secret_github

# Senhas e chaves sensíveis (usar secrets manager em produção)
API_SECRET_KEY=sua_chave_api_secreta_aqui

# ==============================================================================
# 5. ENVIO DE EMAIL
# ==============================================================================

# SMTP (para enviar emails)
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=seu_email@seu-dominio.com
SMTP_PASSWORD=sua_senha_smtp

# SendGrid (alternativa)
SENDGRID_API_KEY=SG.sua_chave_sendgrid

# Email padrão para envios
DEFAULT_FROM_EMAIL=noreply@seu-dominio.com

# ==============================================================================
# 6. ARMAZENAMENTO (Cloud Storage)
# ==============================================================================

# AWS S3 (para armazenar uploads, assets)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_access_key_aws
AWS_SECRET_ACCESS_KEY=sua_secret_key_aws
AWS_S3_BUCKET=seu-bucket-s3

# Google Cloud Storage (alternativa)
GCS_PROJECT_ID=seu-projeto-gcp
GCS_BUCKET=seu-bucket-gcs
GCS_CREDENTIALS=./credentials/gcs.json

# ==============================================================================
# 7. APIS EXTERNAS
# ==============================================================================

# Firecrawl — Web scraping e extração
FIRECRAWL_API_KEY=fc_sua_chave_firecrawl

# Stripe — Pagamentos
STRIPE_PUBLIC_KEY=pk_live_sua_chave_publica
STRIPE_SECRET_KEY=sk_live_sua_chave_secreta
STRIPE_WEBHOOK_SECRET=whsec_sua_webhook_secret

# Twilio — SMS / WhatsApp
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_PHONE_NUMBER=+5511999999999

# ==============================================================================
# 8. TRANSFERÊNCIA E SINCRONIZAÇÃO DE DADOS
# ==============================================================================

# FTP / SFTP
FTP_HOST=ftp.seu-servidor.com
FTP_USUARIO=seu_usuario_ftp
FTP_SENHA=sua_senha_ftp
FTP_PORTA=21

# WebDAV (sincronização de arquivos)
WEBDAV_URL=https://seu-webdav.com
WEBDAV_USER=seu_usuario
WEBDAV_PASSWORD=sua_senha

# ==============================================================================
# 9. MONITORAMENTO E OBSERVABILIDADE
# ==============================================================================

# Sentry (error tracking)
SENTRY_DSN=https://sua_chave@sentry.io/seu_projeto_id

# Datadog (APM, logs, metrics)
DATADOG_API_KEY=sua_chave_datadog
DATADOG_SITE=datadoghq.com  # ou datadoghq.eu para EU

# New Relic (monitoramento)
NEW_RELIC_LICENSE_KEY=sua_licenca_new_relic

# ==============================================================================
# 10. CONFIGURAÇÕES DE PROJETO ESPECÍFICO
# ==============================================================================

# Customize conforme seu projeto:

# Exemplo: Se projeto tem integração com Slack
# SLACK_BOT_TOKEN=xoxb-sua-token-slack
# SLACK_CHANNEL_ALERTS=#alerts

# Exemplo: Se projeto tem webhooks
# WEBHOOK_SECRET=sua_chave_webhook_secreta

# Exemplo: Feature flags
# FEATURE_FLAG_NEW_UI=true
# FEATURE_FLAG_BETA_API=false

# ==============================================================================
# DICAS DE SEGURANÇA
# ==============================================================================
#
# ✅ DO:
# - Use variáveis de ambiente para TODOS os dados sensíveis
# - Adicione .env ao .gitignore
# - Rotacione chaves e senhas regularmente
# - Use secrets manager em produção (GitHub Secrets, AWS Secrets Manager, etc.)
# - Documente cada variável (deixe comentários úteis)
#
# ❌ DON'T:
# - Commit .env no repositório
# - Hardcode chaves no código
# - Compartilhe .env com não-engenheiros
# - Use mesma chave em dev e produção
# - Deixar variáveis vazias em produção
#

# ==============================================================================
# PRÓXIMOS PASSOS
# ==============================================================================
#
# 1. cp .env.example .env
# 2. Preencha .env com seus valores reais
# 3. Teste com: npm run dev
# 4. Se houver erro de variável não definida, adicione aqui
#
